<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>
    <Version>2.0.0</Version>
    <Authors>Constant Segretain</Authors>
    <Product>WinPloy</Product>
    <Copyright>Constant Segretain</Copyright>
    <!-- Le SDK PowerShell embarque de nombreuses ressources localisées : seules les ressources françaises sont gardées. -->
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
