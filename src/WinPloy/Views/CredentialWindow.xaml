<Window x:Class="WinPloy.Views.CredentialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner" Title="Compte WinRM" Width="460">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{StaticResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource DialogPrimaryButton}" Content="Utiliser ce compte" IsDefault="True" Click="BtnOk_Click" />
                <Button Style="{StaticResource DialogButton}" Content="Compte courant" IsCancel="True"
                        ToolTip="Ouvrir les sessions avec le compte qui exécute WinPloy" />
            </StackPanel>
        </Border>

        <StackPanel Margin="24,20,24,24">
            <TextBlock Style="{StaticResource DialogHeading}" Text="Compte WinRM" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,20"
                       Text="Compte administrateur des postes ciblés. Il sert à ouvrir les sessions WinRM pour toute l'opération." />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Utilisateur" />
            <TextBox x:Name="TxtUser" Tag="DOMAINE\utilisateur, POSTE\utilisateur ou .\utilisateur" Margin="0,0,0,16" />

            <TextBlock Style="{StaticResource FieldLabel}" Text="Mot de passe" />
            <PasswordBox x:Name="PwdBox" />
        </StackPanel>
    </DockPanel>
</Window>
